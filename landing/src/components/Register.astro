---
import L from "./L.astro";

const entries = [
  {
    en: ["Task mandate and lease", "Capabilities scoped to one task, not to one user. A lease cannot be reused across agents, tasks or clients."],
    pl: ["Mandat i lease zadania", "Uprawnienia przypisane do jednego zadania, nie do jednego użytkownika. Leasu nie da się użyć ponownie w innym agencie, zadaniu czy kliencie."],
    ref: "aegis/tasks.py",
  },
  {
    en: ["Data lineage", "Classification follows the data, not the model's opinion. Labels come from a trusted catalog, and encoding does not launder them."],
    pl: ["Pochodzenie danych", "Klasyfikacja idzie za danymi, nie za opinią modelu. Etykiety pochodzą z zaufanego katalogu, a kodowanie ich nie czyści."],
    ref: "aegis/engine.py",
  },
  {
    en: ["Proof of enforcement", "Every decision records tool_invoked, and backend counters show that a blocked mail never arrived. Enforcement you can check, not a promise."],
    pl: ["Dowód egzekwowania", "Każda decyzja zapisuje tool_invoked, a liczniki backendu pokazują, że zablokowany mail nigdy nie dotarł. Egzekwowanie do sprawdzenia, nie obietnica."],
    ref: "aegis/backends.py",
  },
  {
    en: ["Budget escrow", "Reserve before execute, atomic in Postgres. A runaway agent hits a wall, not an invoice."],
    pl: ["Escrow budżetu", "Rezerwacja przed wykonaniem, atomowa w Postgresie. Agent, który oszalał, trafia na mur, a nie na fakturę."],
    ref: "aegis/budget.py",
  },
  {
    en: ["Hybrid defence", "Deterministic rules decide authority. The AI model only tightens. When the detector says safe on a real exfiltration, the data-flow rule still blocks."],
    pl: ["Obrona hybrydowa", "Reguły deterministyczne rozstrzygają o uprawnieniach. Model AI może tylko zaostrzyć. Gdy detektor uzna prawdziwą eksfiltrację za bezpieczną, reguła przepływu danych i tak blokuje."],
    ref: "aegis/semantic.py",
  },
];
---
<section class="section" id="proof">
  <div class="wrap">
    <h2><L en="What makes it different" pl="Co go wyróżnia" /></h2>
    <p class="lede">
      <L
        en="Guardrails that pattern-match output stop some attacks. Authority, lineage and budgets stop the rest, and leave evidence."
        pl="Zabezpieczenia szukające wzorców w odpowiedziach zatrzymują część ataków. Uprawnienia, pochodzenie danych i budżety zatrzymują resztę i zostawiają po sobie dowody."
      />
    </p>
    <div class="register">
      {entries.map((e) => (
        <div class="entry">
          <h3><L en={e.en[0]} pl={e.pl[0]} /></h3>
          <p><L en={e.en[1]} pl={e.pl[1]} /></p>
          <span class="ref">{e.ref}</span>
        </div>
      ))}
    </div>
  </div>
</section>
