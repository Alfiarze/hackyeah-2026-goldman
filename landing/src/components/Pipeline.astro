---
import L from "./L.astro";

const stages = [
  {
    en: ["Rate limit", "Per agent, per user and global, per minute. Over the limit: 429. Ten blocks in 60 seconds trip a circuit breaker for the task."],
    pl: ["Limit częstości", "Na agenta, użytkownika i globalnie, na minutę. Ponad limit: 429. Dziesięć blokad w 60 sekund otwiera bezpiecznik dla zadania."],
  },
  {
    en: ["Mandate", "A task pass signed with HMAC, with a TTL: which tools, files and recipients, bound to one agent and one principal. Delegation depth ≤ 3, a subset of the parent's rights."],
    pl: ["Mandat", "Przepustka zadania podpisana HMAC, z TTL: jakie narzędzia, pliki i odbiorcy, związana z jednym agentem i principalem. Delegacja do głębokości 3, tylko podzbiór praw rodzica."],
  },
  {
    en: ["Known attacks", "13 signatures from <span class='id'>feeds/attacks.yaml</span>: pickle, reverse shells, <span class='id'>rm -rf</span>, XSS, SQLi, SSRF, path traversal, vulnerable components, typosquats."],
    pl: ["Znane ataki", "13 sygnatur z <span class='id'>feeds/attacks.yaml</span>: pickle, reverse shelle, <span class='id'>rm -rf</span>, XSS, SQLi, SSRF, path traversal, podatne komponenty, typosquaty."],
  },
  {
    en: ["Patterns", "Polish PII with checksums, passwords written in a sentence, API keys, connection strings, prompt injection. Text is de-obfuscated first."],
    pl: ["Wzorce", "Polskie dane osobowe z sumami kontrolnymi, hasła wpisane w zdanie, klucze API, connection stringi, prompt injection. Tekst jest najpierw odszyfrowywany z maskowania."],
  },
  {
    en: ["Data flow", "Reading a confidential file taints the whole task. Paraphrase or encoding does not launder it. External mail is cleared for public data only."],
    pl: ["Przepływ danych", "Przeczytanie poufnego pliku zanieczyszcza całe zadanie. Parafraza ani kodowanie tego nie czyszczą. Mail na zewnątrz jest dopuszczony tylko dla danych publicznych."],
  },
  {
    en: ["Human approval", "Risky tools such as <span class='id'>http.post</span> wait for a person. The call runs once, and only if approved."],
    pl: ["Zgoda człowieka", "Ryzykowne narzędzia, jak <span class='id'>http.post</span>, czekają na człowieka. Wywołanie wykona się raz i tylko po akceptacji."],
  },
  {
    en: ["AI review", "An on-prem model scores untrusted text for manipulation. It can only tighten a decision; if it is down, the request is blocked."],
    pl: ["Ocena AI", "Model on-prem ocenia niezaufaną treść pod kątem manipulacji. Może tylko zaostrzyć decyzję, a gdy nie odpowiada, żądanie jest blokowane."],
  },
  {
    en: ["Budget escrow", "Tokens and calls are reserved before the call, atomically in Postgres, across task, parent, user and global."],
    pl: ["Escrow budżetu", "Tokeny i wywołania są rezerwowane przed wywołaniem, atomowo w Postgresie, dla zadania, rodzica, użytkownika i globalnie."],
  },
  {
    en: ["Execute", "Only now does the model or tool run. <span class='id'>code.run</span> goes to a throw-away sandbox with no network."],
    pl: ["Wykonanie", "Dopiero teraz działa model albo narzędzie. <span class='id'>code.run</span> trafia do jednorazowej piaskownicy bez sieci."],
  },
  {
    en: ["Output check", "DLP on the response before the agent sees it: secrets and personal data are redacted or the result is withheld."],
    pl: ["Kontrola wyjścia", "DLP na odpowiedzi, zanim zobaczy ją agent: sekrety i dane osobowe są redagowane albo wynik jest wstrzymany."],
  },
];

const stats = [
  ["10", "stages, cheapest first", "etapów, najtańsze najpierw"],
  ["0.3 ms", "p50 decision", "p50 decyzji"],
  ["~9 ms", "tool call through the gate", "wywołanie narzędzia przez bramkę"],
  ["3", "outcomes: ALLOW, REDACT, BLOCK", "werdykty: ALLOW, REDACT, BLOCK"],
];
---
<section class="section" id="how">
  <div class="wrap">
    <h2 class="display" data-reveal><L en="Ten checks, cheapest first" pl="Dziesięć kontroli, najtańsze najpierw" /></h2>
    <p class="lede" data-reveal style="--i: 1">
      <L
        en="Every call to a model, tool, MCP server or another agent walks the same pipeline. Cheap checks run first, so most attacks stop in microseconds."
        pl="Każde wywołanie modelu, narzędzia, serwera MCP czy innego agenta przechodzi ten sam ciąg kontroli. Tanie kontrole idą pierwsze, więc większość ataków odpada w mikrosekundach."
      />
    </p>
    <dl class="stats" data-reveal-group>
      {stats.map(([n, en, pl]) => (
        <div data-reveal><dt>{n}</dt><dd><L en={en} pl={pl} /></dd></div>
      ))}
    </dl>
    <div class="pipe-req" aria-hidden="true">
      <span class="pipe-call" data-pipe-call></span>
      <span class="pipe-out" data-pipe-out></span>
    </div>
    <div class="stages" data-pipeline data-reveal-group>
      <span class="pipe-token" aria-hidden="true"></span>
      {stages.map((s, i) => (
        <div class="stage" data-reveal>
          <span class="stage-no">{String(i + 1).padStart(2, "0")}<span class="stage-v" aria-hidden="true"><span class="v-pass">PASS</span><span class="v-block">BLOCK</span></span></span>
          <h3><L en={s.en[0]} pl={s.pl[0]} /></h3>
          <p><L en={s.en[1]} pl={s.pl[1]} /></p>
        </div>
      ))}
      <div class="stage-last" data-reveal>
        <p>
          <L
            en="<b>ALLOW, REDACT or BLOCK.</b> Every decision lands with its rule and reason in an audit log the database will not let anyone update or delete."
            pl="<b>ALLOW, REDACT albo BLOCK.</b> Każda decyzja trafia z regułą i powodem do dziennika audytu, którego baza nie pozwala nikomu zmieniać ani usuwać."
          />
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // While the pipeline is on screen, a request walks it: each check lights up in turn. Runs
  // alternate between a clean call that executes and an exfiltration stopped at the data-flow check.
  const box = document.querySelector<HTMLElement>("[data-pipeline]");
  if (box && document.documentElement.classList.contains("motion")) {
    const stages = Array.from(box.querySelectorAll<HTMLElement>(".stage"));
    const last = box.querySelector<HTMLElement>(".stage-last");
    const token = box.querySelector<HTMLElement>(".pipe-token")!;
    const call = document.querySelector<HTMLElement>("[data-pipe-call]")!;
    const out = document.querySelector<HTMLElement>("[data-pipe-out]")!;
    const runs = [
      { call: "model.chat · summarize contract · lawyer_anna", blockAt: -1, out: "→ ALLOW · executed" },
      { call: "mail.send → partner@client-A.example", blockAt: 4, out: "→ BLOCKED · IFC-001" },
      { call: "code.run · rm -rf / --no-preserve-root", blockAt: 2, out: "→ BLOCKED · ATK-EXEC-003" },
      { call: "code.run · parse_invoice.py", blockAt: -1, out: "→ ALLOW · executed in sandbox" },
      { call: "doc.read × 400 / min · runaway loop", blockAt: 0, out: "→ BLOCKED · RATE-001 (429)" },
      { call: "model.pull · hf.co/meta-llarna/…", blockAt: 2, out: "→ BLOCKED · ATK-SUPPLY-001" },
    ];
    const STEP = 420;
    let run = 0;
    let visible = false;
    let busy = false;
    const wait = (ms: number) => new Promise((r) => window.setTimeout(r, ms));

    const place = (el: HTMLElement) => {
      // the token is a 100px bar scaled to the height of the stage it is reading
      const top = el.offsetTop;
      const h = el.offsetHeight;
      token.style.transform = `translateY(${top}px) scaleY(${(h / 100).toFixed(3)})`;
    };

    const reset = () => {
      stages.forEach((s) => s.classList.remove("is-active", "is-pass", "is-block"));
      last?.classList.remove("is-run");
      box.classList.remove("is-running", "is-blocked");
      out.textContent = "";
      out.className = "pipe-out";
    };

    const loop = async () => {
      if (busy) return;
      busy = true;
      while (visible && !document.hidden) {
        const r = runs[run++ % runs.length];
        reset();
        call.textContent = r.call;
        box.classList.add("is-running");
        for (let i = 0; i < stages.length && visible; i++) {
          const s = stages[i];
          place(s);
          s.classList.add("is-active");
          await wait(STEP);
          s.classList.remove("is-active");
          if (i === r.blockAt) {
            s.classList.add("is-block");
            box.classList.add("is-blocked");
            out.textContent = r.out;
            out.classList.add("is-block", "is-shown");
            break;
          }
          s.classList.add("is-pass");
        }
        if (r.blockAt < 0 && last) {
          place(last);
          last.classList.add("is-run");
          out.textContent = r.out;
          out.classList.add("is-shown");
        }
        await wait(2600);
        box.classList.remove("is-running");
        await wait(500);
      }
      reset();
      busy = false;
    };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) window.setTimeout(loop, 900);
    }, { threshold: 0.25 }).observe(box);
    document.addEventListener("visibilitychange", () => { if (!document.hidden && visible) loop(); });
  }
</script>
