---
import { dashboardUrl } from "../config";
import L from "./L.astro";
import Rosette from "./Rosette.astro";
---
<header class="top">
  <div class="wrap">
    <a class="brand" href={import.meta.env.BASE_URL}>
      <Rosette size={30} />
      <span class="wordmark">Mandate</span>
    </a>
    <nav aria-label="Sections">
      <a href="#how"><L en="How it works" pl="Jak to działa" /></a>
      <a href="#proof"><L en="Proof" pl="Dowód" /></a>
      <a href="#scenarios"><L en="Scenarios" pl="Scenariusze" /></a>
    </nav>
    <div class="top-tools">
      <div class="lang" role="group" aria-label="Language">
        <button type="button" data-set-lang="pl" aria-pressed="false">PL</button>
        <button type="button" data-set-lang="en" aria-pressed="true">EN</button>
      </div>
      <a class="console-btn" href={`${dashboardUrl}`}><L en="Open dashboard" pl="Otwórz dashboard" /></a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-set-lang]");
  const apply = (lang: string) => {
    root.dataset.lang = lang;
    root.lang = lang;
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setLang === lang)));
  };
  buttons.forEach((b) => b.addEventListener("click", () => {
    const lang = b.dataset.setLang ?? "en";
    apply(lang);
    try { localStorage.setItem("mandate-lang", lang); } catch { /* private mode */ }
  }));
  apply(root.dataset.lang ?? "en");
</script>
