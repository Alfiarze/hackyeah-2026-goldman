# Postgres
POSTGRES_DB=goldman
POSTGRES_USER=goldman
POSTGRES_PASSWORD=goldman
POSTGRES_PORT=5432

# Gateway
GATEWAY_PORT=8000

# Ollama: host Ollama by default (macOS Metal). With `--profile ollama` use http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
TOOLS_PORT=8001

# Keys (change for anything beyond a local demo)
# dashboard / admin API
ADMIN_API_KEY=dev-admin-key
# trusted app that creates tasks (mandates)
APP_API_KEY=dev-app-key
# HMAC for task leases
LEASE_SECRET=dev-lease-secret
# only the gateway holds it
TOOL_BACKEND_SECRET=dev-backend-secret
AGENT_KEYS=agent-key-demo:demo-agent,agent-key-other:other-agent

# Optional external threat-intel feed (falls back to feeds/attacks.yaml)
ATTACK_FEED_URL=
