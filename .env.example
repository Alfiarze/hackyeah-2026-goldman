# Postgres
POSTGRES_DB=goldman
POSTGRES_USER=goldman
POSTGRES_PASSWORD=goldman
POSTGRES_PORT=5432

# Gateway
GATEWAY_PORT=8000

TOOLS_PORT=8001

# Keys (change for anything beyond a local demo)
# dashboard / admin API
ADMIN_API_KEY=hackyeah
# trusted app that creates tasks (mandates)
APP_API_KEY=dev-app-key
# HMAC for task leases
LEASE_SECRET=dev-lease-secret
# only the gateway holds it
TOOL_BACKEND_SECRET=dev-backend-secret
SANDBOX_SECRET=dev-sandbox-secret
AGENT_KEYS=agent-key-demo:demo-agent,agent-key-other:other-agent

# Optional external threat-intel feed (falls back to feeds/attacks.yaml)
ATTACK_FEED_URL=


# Main model server: any OpenAI-compatible API. Used by the agent console and the AI review.
# Testing: OpenRouter (put your key in LLM_API_KEY). Production: the team's GB10, e.g.
#   LLM_BASE_URL=http://<gb10-host>:8000/v1   LLM_API_KEY=<if the server needs one>   LLM_MODEL=<served model id>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Where that server lives, for the data-flow rule: onprem (GB10: confidential data allowed) | cloud (public only).
# While testing through OpenRouter data really goes to the cloud: use only the synthetic demo documents.
LLM_LOCATION=onprem
# Extra JSON for every request. OpenRouter: turn off reasoning so answers are not cut off.
# GB10 with vLLM/SGLang: e.g. {"chat_template_kwargs": {"enable_thinking": false}} or leave empty.
LLM_EXTRA_BODY={"reasoning": {"enabled": false}}

# Landing page container (make landing). Where its "Open the dashboard" links point.
LANDING_PORT=8080
PUBLIC_DASHBOARD_URL=http://localhost:8000/dashboard/
