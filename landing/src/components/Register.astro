---
import L from "./L.astro";

const entries = [
  {
    en: ["Task mandate and lease", "Rights scoped to one task, signed with HMAC, with a TTL. Delegation up to depth 3, each child a subset of its parent, inheriting its confidentiality: no confused deputy."],
    pl: ["Mandat i lease zadania", "Uprawnienia przypisane do jednego zadania, podpisane HMAC, z TTL. Delegacja do głębokości 3, każde dziecko to podzbiór rodzica i dziedziczy jego poufność: bez confused deputy."],
    ref: "aegis/tasks.py",
  },
  {
    en: ["Data lineage", "Classification follows the data, not the model's opinion. Paraphrase, translation or encoding does not launder it."],
    pl: ["Pochodzenie danych", "Klasyfikacja idzie za danymi, nie za opinią modelu. Parafraza, tłumaczenie ani kodowanie jej nie czyszczą."],
    ref: "aegis/engine.py",
  },
  {
    en: ["Documents as evidence", "Real PDF, Office and image files are opened, scans go through OCR, and every finding names its place: XMP, a hidden sheet, slide notes."],
    pl: ["Dokumenty jako dowód", "Prawdziwe pliki PDF, Office i obrazy są otwierane, skany przechodzą OCR, a każde znalezisko wskazuje miejsce: XMP, ukryty arkusz, notatki slajdu."],
    ref: "aegis/documents.py",
  },
  {
    en: ["Human in the loop", "A risky call is held, a person approves or denies it in the dashboard, and it runs exactly once."],
    pl: ["Człowiek w pętli", "Ryzykowne wywołanie czeka, człowiek akceptuje albo odrzuca je w dashboardzie, a ono wykonuje się dokładnie raz."],
    ref: "aegis/engine.py",
  },
  {
    en: ["Budget escrow and brakes", "Reserve before execute, atomic in Postgres. Rate limits per agent, user and globally; a circuit breaker after 10 blocks in 60 s."],
    pl: ["Escrow budżetu i hamulce", "Rezerwacja przed wykonaniem, atomowa w Postgresie. Limity na agenta, użytkownika i globalnie; bezpiecznik po 10 blokadach w 60 s."],
    ref: "aegis/budget.py",
  },
  {
    en: ["Hybrid defence", "Deterministic rules decide authority. The AI model only tightens. When the detector says safe on a real exfiltration, the data-flow rule still blocks."],
    pl: ["Obrona hybrydowa", "Reguły deterministyczne rozstrzygają o uprawnieniach. Model AI może tylko zaostrzyć. Gdy detektor uzna prawdziwą eksfiltrację za bezpieczną, reguła przepływu danych i tak blokuje."],
    ref: "aegis/semantic.py",
  },
  {
    en: ["Proof of enforcement", "Every decision records whether the tool was invoked, and backend counters show that a blocked mail never arrived."],
    pl: ["Dowód egzekwowania", "Każda decyzja zapisuje, czy narzędzie zostało wywołane, a liczniki backendu pokazują, że zablokowany mail nigdy nie dotarł."],
    ref: "aegis/backends.py",
  },
];
---
<section class="section" id="different">
  <div class="wrap">
    <h2 data-reveal><L en="What makes it different" pl="Co go wyróżnia" /></h2>
    <p class="lede" data-reveal style="--i: 1">
      <L
        en="Guardrails that pattern-match output stop some attacks. Authority, lineage and budgets stop the rest, and leave evidence."
        pl="Zabezpieczenia szukające wzorców w odpowiedziach zatrzymują część ataków. Uprawnienia, pochodzenie danych i budżety zatrzymują resztę i zostawiają po sobie dowody."
      />
    </p>
    <div class="register" data-reveal-group>
      {entries.map((e) => (
        <div class="entry" data-reveal>
          <h3><L en={e.en[0]} pl={e.pl[0]} /></h3>
          <p><L en={e.en[1]} pl={e.pl[1]} /></p>
          <span class="ref">{e.ref}</span>
        </div>
      ))}
    </div>
  </div>
</section>
