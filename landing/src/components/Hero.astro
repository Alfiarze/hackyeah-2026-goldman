---
import { dashboardUrl } from "../config";
import L from "./L.astro";
import Rosette from "./Rosette.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const pillars = [
  { en: ["Task mandates", "A signed, expiring pass per task: tools, files, recipients, budget. Sub-agents get a subset, never more."],
    pl: ["Mandaty zadań", "Podpisana, wygasająca przepustka na zadanie: narzędzia, pliki, odbiorcy, budżet. Podagent dostaje podzbiór, nigdy więcej."] },
  { en: ["Data boundaries", "Polish PII, passwords and secrets are redacted; confidential data cannot leave for a less trusted place."],
    pl: ["Granice danych", "Polskie dane osobowe, hasła i sekrety są redagowane, a dane poufne nie wyjdą w mniej zaufane miejsce."] },
  { en: ["Attacks and documents", "Injection in any disguise, 13 attack signatures, hidden text and macros in PDF, Office files and scans."],
    pl: ["Ataki i dokumenty", "Injection w każdym przebraniu, 13 sygnatur ataków, ukryty tekst i makra w PDF, plikach Office i skanach."] },
  { en: ["People and evidence", "Risky tools wait for human approval. Every decision is in an audit log nobody can edit."],
    pl: ["Ludzie i dowody", "Ryzykowne narzędzia czekają na zgodę człowieka. Każda decyzja trafia do dziennika, którego nikt nie zmieni."] },
];
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy" data-reveal-group>
      <h1>
        <span class="hero-name" data-reveal>Aegis</span>
        <span class="hero-tag" data-reveal><L en="Control gateway for AI agents." pl="Bramka kontroli dla agentów AI." /></span>
      </h1>
      <p class="hero-claim" data-reveal>
        <L en="Define what an agent may do. Enforce it on every call." pl="Określ, co agent może zrobić. Egzekwuj to przy każdym wywołaniu." />
      </p>
      <p class="lede" data-reveal>
        <L
          en="Aegis sits between AI agents and everything they touch: models, tools, MCP servers, documents and other agents. Ten checks in about 0.3 ms decide whether this agent was authorized to do it, with this data, for this task. Swap one <span class='id'>base_url</span> to put it in front of your agents."
          pl="Aegis stoi między agentami AI a wszystkim, czego dotykają: modelami, narzędziami, serwerami MCP, dokumentami i innymi agentami. Dziesięć kontroli w około 0,3 ms rozstrzyga, czy ten agent był do tego upoważniony, z tymi danymi i w tym zadaniu. Wystarczy podmienić jeden <span class='id'>base_url</span>."
        />
      </p>
      <div class="hero-ctas" data-reveal>
        <a class="console-btn big" href={`${dashboardUrl}`} data-dashboard=""><L en="Open the dashboard" pl="Otwórz dashboard" /></a>
        <a class="ghost-btn" href="#scenarios"><L en="Run the attacks yourself" pl="Sprawdź ataki sam" /></a>
      </div>
    </div>
    <figure class="hero-art">
      <!-- transparent light line-work: no blend modes, so no backdrop can show through in any browser -->
      <picture>
        <img
          src={`${base}art/engraving-hero-dark.webp`}
          width="780" height="740"
          alt=""
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <!-- a live guilloché layer over the engraved one: draws itself in, then turns very slowly -->
      <Rosette size={64} class="hero-rosette" />
      <span class="hero-serial" aria-hidden="true" data-serial="4817">Nº AE·26 <b>{"004817".split("").map((d) => <i>{d}</i>)}</b></span>
    </figure>
  </div>

  <div class="wrap">
    <ul class="pillars" data-reveal-group>
      {pillars.map((p) => (
        <li data-reveal>
          <h2><L en={p.en[0]} pl={p.pl[0]} /></h2>
          <p><L en={p.en[1]} pl={p.pl[1]} /></p>
        </li>
      ))}
    </ul>
  </div>
</section>
