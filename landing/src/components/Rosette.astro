---
// The guilloche rosette from the dashboard, precomputed as static SVG paths.
interface Props { size?: number; class?: string }
const { size = 30, class: className } = Astro.props;

const ring = (base: number, amp: number, lobes: number, phase: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 720; i++) {
    const a = (i / 720) * Math.PI * 2;
    const rad = base + amp * Math.sin(lobes * a + phase);
    pts.push(`${(16 + rad * Math.cos(a)).toFixed(2)},${(16 + rad * Math.sin(a)).toFixed(2)}`);
  }
  return `M${pts.join("L")}Z`;
};

const paths = [
  ring(11.5, 1.6, 18, 0),
  ring(11.5, 1.6, 18, Math.PI),
  ring(7, 2.2, 12, 0),
  ring(7, 2.2, 12, Math.PI),
  ring(3.2, 0.9, 8, 0),
];
---
<svg class:list={["rosette", className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="15.5" />
  {paths.map((d) => <path d={d} />)}
</svg>
