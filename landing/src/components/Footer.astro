---
import { dashboardUrl } from "../config";
import L from "./L.astro";
import Rosette from "./Rosette.astro";
---
<footer>
  <div class="wrap">
    <span class="foot-brand"><Rosette size={22} /> Mandate</span>
    <p class="foot-line">
      <L
        en="A gateway between agents and everything they touch. Every task gets a mandate, every call gets checked, every decision leaves evidence."
        pl="Bramka między agentami i wszystkim, czego dotykają. Każde zadanie dostaje mandat, każde wywołanie jest sprawdzane, każda decyzja zostawia ślad."
      />
    </p>
    <p class="foot-line">
      <L
        en="HackYeah 2026, Goldman Sachs AI Control Layer challenge."
        pl="HackYeah 2026, wyzwanie Goldman Sachs AI Control Layer."
      />
    </p>
    <div class="foot-links">
      <a href={`${dashboardUrl}`}><L en="Dashboard" pl="Dashboard" /></a>
      <a href="/docs"><L en="API docs" pl="Dokumentacja API" /></a>
      <a href="#how"><L en="How it works" pl="Jak to działa" /></a>
    </div>
  </div>
</footer>
