---
import L from "./L.astro";

// Titles match the dashboard's "Run a scenario" view; rule ids are the ones the gateway records.
const runs = [
  {
    title: ["A normal day", "Zwykły dzień pracy"],
    en: "The agent searches case law, reads the client's contract, asks the local model for risks and files a memo. Nothing gets in its way.",
    pl: "Agent przeszukuje orzecznictwo, czyta umowę klienta, pyta lokalny model o ryzyka i zapisuje notatkę. Nic mu nie przeszkadza.",
    action: "allow",
  },
  {
    title: ["Poisoned contract", "Zatruta umowa"],
    en: "A hidden instruction tells the agent to mail the contract to an outside address. The mail backend never fires.",
    pl: "Ukryta instrukcja każe agentowi wysłać umowę na obcy adres. Backend poczty nigdy nie odpala.",
    action: "block", rule: "MANDATE-RCPT",
  },
  {
    title: ["The AI detector misses", "Detektor AI przeocza atak"],
    en: "The semantic detector calls the request safe and the recipient is allowed. The data-flow rule blocks it anyway.",
    pl: "Detektor semantyczny uznaje żądanie za bezpieczne, a odbiorca jest dozwolony. Reguła przepływu danych i tak je blokuje.",
    action: "block", rule: "IFC-001",
  },
  {
    title: ["Wrong client's files", "Dokumenty innego klienta"],
    en: "An agent working for client A reaches for client B's NDA, then tries a path trick.",
    pl: "Agent pracujący dla klienta A sięga po NDA klienta B, a potem próbuje sztuczki ze ścieżką.",
    action: "block", rule: "MANDATE-RES",
  },
  {
    title: ["Reused credentials", "Ponowne użycie przepustki"],
    en: "A finished task is replayed with its old lease. The gate treats it as if it never existed.",
    pl: "Zakończone zadanie jest odtwarzane ze starym lease'em. Bramka traktuje go, jakby nigdy nie istniał.",
    action: "block", rule: "CAPABILITY_COMPLETED",
  },
  {
    title: ["Tool changes after approval", "Narzędzie zmienione po zatwierdzeniu"],
    en: "An MCP tool rewrites its description after approval. It lands in quarantine before the next call.",
    pl: "Narzędzie MCP zmienia opis po zatwierdzeniu. Trafia do kwarantanny przed kolejnym wywołaniem.",
    action: "block", rule: "ATK-MCP-POISON-001",
  },
  {
    title: ["Model supply chain", "Łańcuch dostaw modeli"],
    en: "Models arrive with a pickle that imports os, a vulnerable llama-cpp-python, and a host one letter away from the real one.",
    pl: "Modele przychodzą z plikiem pickle importującym os, podatnym llama-cpp-python i z hosta różniącego się jedną literą od prawdziwego.",
    action: "block", rule: "ATK-SUPPLY-001",
  },
  {
    title: ["Thirty agents, one budget", "Trzydziestu agentów, jeden budżet"],
    en: "Thirty agents spend at once. Reservations settle in Postgres, overspend stays at zero.",
    pl: "Trzydziestu agentów wydaje jednocześnie. Rezerwacje rozlicza Postgres, przekroczenie zostaje na zerze.",
    action: "block", rule: "BUD-001",
  },
];

const word = {
  allow: ["Allowed", "Dozwolone"],
  redact: ["Redacted", "Zredagowane"],
  block: ["Blocked", "Zablokowane"],
};

const owasp = [
  ["LLM01", "Prompt Injection", "Prompt Injection"],
  ["LLM02", "Sensitive Disclosure", "Ujawnienie danych wrażliwych"],
  ["LLM03", "Supply Chain", "Łańcuch dostaw"],
  ["LLM05", "Insecure Output", "Niebezpieczne wyjście"],
  ["LLM06", "Excessive Agency", "Nadmierna autonomia"],
  ["LLM10", "Unbounded Consumption", "Nieograniczone zużycie"],
];
---
<section class="section" id="scenarios">
  <div class="wrap">
    <h2><L en="Try to break it" pl="Spróbuj to obejść" /></h2>
    <p class="lede">
      <L
        en="Each scenario runs a scripted agent through the real gateway, against the real policy and the real backends. Watch the counters while you do it."
        pl="Każdy scenariusz przepuszcza skryptowanego agenta przez prawdziwą bramkę, prawdziwą politykę i prawdziwe backendy. Patrz przy tym na liczniki."
      />
    </p>
    <div class="runs">
      {runs.map((r) => (
        <div class="run">
          <h3><L en={r.title[0]} pl={r.title[1]} /></h3>
          <p><L en={r.en} pl={r.pl} /></p>
          <div class="run-result">
            <span class:list={["mark", `mark-${r.action}`]}><L en={word[r.action][0]} pl={word[r.action][1]} /></span>
            {r.rule && <span class="id">{r.rule}</span>}
          </div>
        </div>
      ))}
    </div>
    <div class="runs-note">
      <a class="console-btn" href="/dashboard/#scenarios"><L en="Run the scenarios" pl="Uruchom scenariusze" /></a>
      <span class="hint">
        <L en="Dashboard, Prove, Run a scenario. No keys, no cloud, everything runs locally." pl="Dashboard, Dowody, Scenariusze. Bez kluczy i chmury, wszystko działa lokalnie." />
      </span>
    </div>
    <div class="owasp">
      <h3><L en="Controls mapped to the OWASP Top 10 for LLM applications" pl="Kontrole przypisane do OWASP Top 10 dla aplikacji LLM" /></h3>
      <ul>
        {owasp.map(([id, en, pl]) => (
          <li>{id} <span><L en={en} pl={pl} /></span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
