---
import { dashboardUrl } from "../config";
import L from "./L.astro";
import Rosette from "./Rosette.astro";
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<header class="top">
  <div class="wrap">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label="Aegis">
      <Rosette size={34} />
      <span class="lockup">
        <span class="wordmark">Aegis</span>
        <span class="lockup-sub"><L en="Control gateway for AI agents" pl="Bramka kontroli dla agentów AI" /></span>
      </span>
    </a>
    <nav aria-label="Sections">
      <a href={`${home}#flow`}><L en="Flow" pl="Przepływ" /></a>
      <a href={`${home}#sandbox`}><L en="Sandbox" pl="Sandbox" /></a>
      <a href={`${home}#benchmark`}><L en="Benchmark" pl="Benchmark" /></a>
      <a href={`${home}#scenarios`}><L en="Try it" pl="Wypróbuj" /></a>
      <a href={`${home}docs/`}><L en="Docs" pl="Docs" /></a>
    </nav>
    <div class="top-tools">
      <a class="console-btn" href={`${dashboardUrl}`} data-dashboard=""><L en="Open the dashboard" pl="Otwórz dashboard" /></a>
    </div>
  </div>
</header>

